# ===== 依赖 =====
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# ===== 环境变量（含数据库密码，禁止入库）=====
.env
.env.local
.env.*.local

# ===== 上传文件（运行时数据，不随代码入库）=====
server/uploads/
uploads/

# ===== AI 工具工作目录（会话日志、临时产物）=====
.workbuddy/
.trae/
.trae-cn/
.trae-html-share-packages/
.claude/

# ===== 临时脚本 =====
tmp_*.py
tmp_*.js
*.tmp

# ===== 数据备份（一次性导出的 SQL 快照，不入库）=====
backups/
*.dump

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器 =====
.vscode/
.idea/
*.swp

# ===== 构建产物 =====
dist/
build/
*.log
